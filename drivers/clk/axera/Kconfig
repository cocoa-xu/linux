config CLK_AX620E_GLB
	tristate "Axera AX620E clock and reset controllers"
	depends on ARCH_AXERA || COMPILE_TEST
	depends on OF
	default ARCH_AXERA
	select RESET_CONTROLLER
	help
	  Clock gates, source muxes, dividers and resets of the Axera
	  AX620E subsystem blocks: USB and SD/SDIO (FLASH_SYS), the video
	  codecs (VPU_SYS) and the low-speed peripherals such as GPIO and
	  I2C (PERIPH_SYS).
