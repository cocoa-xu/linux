# Bring-up additions on top of multi_v7_defconfig for the NanoKVM-Go.
CONFIG_SERIAL_EARLYCON_RAMLOG=y
CONFIG_SERIAL_8250_DW=y
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_MMC_SDHCI_CADENCE=y
CONFIG_ARCH_AXERA=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_AX620E_VIN=y
CONFIG_CLK_AX620E_GLB=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_HANTRO=y
CONFIG_VIDEO_HANTRO_AX620E=y
CONFIG_GPIO_AX620E=y
CONFIG_VIDEO_LT7911EXC=y
CONFIG_I2C_CHARDEV=y
CONFIG_AX620E_WATCHDOG=y
CONFIG_CFG80211=y
CONFIG_AIC8800=m
CONFIG_PHY_AX620E_USB2=y
# The stock U-Boot passes mem=352M; a later mem= adds the rest back.
CONFIG_CMDLINE="mem=512M"
CONFIG_CMDLINE_EXTEND=y
